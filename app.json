{
  "expo": {
    "name": "Direct",
    "description": "A CelcomDigi mobile app prototype that brings customer support directly into the app through a native IMR and live chat experience.",
    "slug": "direct",
    "scheme": "direct",
    "version": "0.3.0",
    "platforms": [
      "ios",
      "android"
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.celcomdigi.direct",
      "supportsTablet": true
    },
    "android": {
      "package": "com.celcomdigi.direct",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": {
            "web": false
          }
        }
      ],
      "expo-font",
      "expo-secure-store"
    ]
  }
}
